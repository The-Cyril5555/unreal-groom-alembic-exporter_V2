	"VersionName": "1.1",
	"FriendlyName": "Groom Alembic Exporter",
	"Description": "Adds a Content Browser action to export a Groom Asset's strand data to an Alembic (.abc) file using UE's groom Alembic schema. Guide curves can be kept, written to separate objects or left out (Blender), and the groom's physics settings can be written next to the file.",
	"Category": "Geometry",
	"CreatedBy": "effectustasi (original author), The-Cyril5555 (1.1 fork)",
	"CreatedByURL": "https://github.com/effectustasi",
	"DocsURL": "https://github.com/The-Cyril5555/unreal-groom-alembic-exporter_V2",
	"MarketplaceURL": "",
	"SupportURL": "",
	"EnabledByDefault": true,
	"CanContainContent": false,
	"IsBetaVersion": false,
	"Installed": false,
	"Modules": [
		{
			"Name": "GroomExportEditor",
			"Type": "Editor",
			"LoadingPhase": "Default"
		}
	],
	"Plugins": [
		{
			"Name": "HairStrands",
			"Enabled": true
		},
		{
			"Name": "AlembicImporter",
			"Enabled": true
		}
	]
}
